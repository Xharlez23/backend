# Puerto del servidor
PORT=4000

# Origen permitido para CORS (URL del front Angular)
CORS_ORIGIN=http://localhost:4200

# Credenciales de la cuenta de servicio de Firebase (Proyecto > Configuracion > Cuentas de servicio > Generar nueva clave privada)
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase.iam.gserviceaccount.com
# Pega la private_key completa (con \n literales) o usa GOOGLE_APPLICATION_CREDENTIALS apuntando al json
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
